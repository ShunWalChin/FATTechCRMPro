# =============================================================================
# /etc/palantyr/openclaw.env — modo 0600, dono root. Gerado pelo Doppler:
#   doppler secrets download --project palantyr --config prd_h1 --no-file --format env \
#     | sudo install -m 0600 /dev/stdin /etc/palantyr/openclaw.env
# NUNCA commitar o arquivo real. Este exemplo documenta os NOMES, não os valores.
# =============================================================================

# --- Gateway ------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=            # openssl rand -hex 32
OPENCLAW_HOOKS_TOKEN=              # openssl rand -hex 32 (diferente do gateway)

# --- Dono ---------------------------------------------------------------------
WAL_WHATSAPP_E164=                 # número pessoal do Wal, formato +55DDDNNNNNNNNN

# --- Modelos ------------------------------------------------------------------
OPENROUTER_API_KEY=                # chave com limite de gasto mensal configurado no painel
# NVIDIA_API_KEY=                  # SÓ em ambiente de avaliação (evals/). Proibido em produção.

# --- Identidades dos agentes no CRM (POST /api/v1/agent/identity) --------------
CRM_AGENT_ID_MARVIN=
CRM_KEY_MARVIN=
CRM_AGENT_ID_TRAFEGO=
CRM_KEY_TRAFEGO=
CRM_AGENT_ID_SDR=
CRM_KEY_SDR=
CRM_AGENT_ID_CONTEUDO=
CRM_KEY_CONTEUDO=
CRM_AGENT_ID_COBRANCA=
CRM_KEY_COBRANCA=
CRM_AGENT_ID_SENTINELA=
CRM_KEY_SENTINELA=

# --- Borda (H2, via tailnet) ----------------------------------------------------
N8N_MCP_URL=                       # https://h2.<tailnet>.ts.net:8443/mcp/palantyr
N8N_MCP_TOKEN=                     # Bearer do MCP Server Trigger do n8n

# --- Sonda de saúde (lista FECHADA, nome=url separados por vírgula) ------------
PROBE_TARGETS=crm-api=http://api:8000/api/v1/health,crm-web=http://web:3000/,n8n=https://n8n.pltr.fattech.com.br/healthz,evolution=https://evolution.pltr.fattech.com.br/,minaspecas=https://minaspecas.com.br/,barract=https://barract.com.br/,gatamalhada=https://gatamalhada.com.br/
