# Install as a NEW server block after allocating DNS and an appropriate certificate.
# Keep existing sites and global nginx configuration intact.
server {
    listen 80;
    server_name fattech.com.br www.fattech.com.br crm.fattech.com.br;
    location /.well-known/acme-challenge/ { root /var/www/fattech-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name fattech.com.br www.fattech.com.br crm.fattech.com.br;
    ssl_certificate /etc/letsencrypt/live/fattech.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fattech.com.br/privkey.pem;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    location /api/ {
        proxy_pass http://127.0.0.1:4321;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location / {
        proxy_pass http://127.0.0.1:4320;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
